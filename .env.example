# Copy to .env and fill in. .env is git-ignored. Placeholders only here, never real secrets.
# Format is KEY=VALUE without quotes and without trailing comments
# (the app reads this file as a .properties file; docker compose reads it too).

# --- Database ---
DB_NAME=rag
# Host port for the compose Postgres. 54320 avoids clashing with Postgres instances commonly running on 5432-5433.
DB_PORT=54320
DB_URL=jdbc:postgresql://localhost:54320/rag
DB_USER=rag
DB_PASSWORD=change-me

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
# Optional: proxy or compatible gateway. Default https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(N) column created by Flyway. The app fails fast on mismatch.
# Changing it later needs a new migration: the column type is fixed when V3 is applied.
EMBEDDING_DIMENSION=1536

# --- Auth ---
# At least 32 characters of randomness, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Ingestion and retrieval ---
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
TOP_K=5
MAX_UPLOAD_MB=20
# Minimum cosine similarity for a chunk to reach the LLM (unless it also matched by keywords).
# Not calibrated for your model/data: tune it with the retrieval inspector.
MIN_SIMILARITY=0.20

# --- Rate limits (requests per minute) ---
RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- Logging ---
# Question/answer text is only written to the application log when true.
LOG_PAYLOADS=false

# --- Server ---
# Port when running with mvn / the IDE. Inside docker compose the app always listens on 8080.
SERVER_PORT=8080
# Host port published by docker compose for the app container.
APP_PORT=8080
